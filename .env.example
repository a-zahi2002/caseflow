# Caseflow Environment Variables

# ==========================================
# API Server Configuration (apps/api)
# ==========================================
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/caseflow?schema=public"

# Authentication (better-auth)
BETTER_AUTH_SECRET="your-super-secret-key-min-32-chars-long"
BETTER_AUTH_URL="http://localhost:3001"

# Redis Cache (Optional: Falls back to in-memory if omitted)
REDIS_URL="redis://localhost:6379"

# AI Provider Configuration
# Supported: 'ollama' or 'openai'
AI_PROVIDER="ollama"

# Ollama Settings
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# OpenAI Settings (If using AI_PROVIDER="openai")
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Email Configuration (Nodemailer)
# Falls back to console.log if credentials are empty
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@caseflow.local"

# ==========================================
# Frontend Configuration (apps/web)
# ==========================================
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
